NODE_ENV=development
PORT=5177

# Gemini is the default image/vision provider; text uses VyceAI -> ShopAIKey.
AI_PROVIDER=gemini
AI_AUTO_TEXT_ROUTING=true
# Text only: discover GPT, then Claude; probe health before each real request.
# VYCEAI_API_KEY=replace-with-your-vyceai-key
VYCEAI_BASE_URL=https://vyceai.com/v1
VYCEAI_TIMEOUT_MS=60000
VYCEAI_HEALTH_TIMEOUT_MS=10000
# AI_TEXT_PROVIDER=gemini
# AI_VISION_PROVIDER=gemini
# AI_IMAGE_PROVIDER=gemini

GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL_TEXT=gemini-2.5-flash-lite
GEMINI_MODEL_MULTIMODAL=gemini-2.5-flash
# Set an available image model from your Gemini account before starting.
GEMINI_MODEL_IMAGE=replace-with-an-available-image-model

# ShopAIKey supports text, vision, Gemini images, GPT Image and Grok Imagine.
# AI_TEXT_PROVIDER=shopaikey
# AI_VISION_PROVIDER=shopaikey
# AI_IMAGE_PROVIDER=shopaikey
# SHOPAIKEY_API_KEY=replace-with-your-shopaikey-key
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
SHOPAIKEY_IMAGE_BASE_URL=https://direct.shopaikey.com
SHOPAIKEY_MODEL_TEXT=gemini-2.5-flash
SHOPAIKEY_MODEL_VISION=gemini-2.5-flash
# Required for images; use a Gemini image, gpt-image-* or grok-imagine-image* ID from the catalog.
# SHOPAIKEY_MODEL_IMAGE=replace-with-an-available-image-model
SHOPAIKEY_TIMEOUT_MS=60000
SHOPAIKEY_IMAGE_TIMEOUT_MS=180000

R2_ACCOUNT_ID=replace-with-your-account-id
R2_PRIVATE_URL=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=replace-with-your-bucket
# Separate this application's object keys when sharing the bucket with EziHubb.
# Prefix has no leading/trailing slash; public URL is the bucket's CDN root.
R2_KEY_PREFIX=gemini-tools
R2_PUBLIC_URL=https://replace-with-your-public-domain.example
R2_ACCESS_KEY_ID=replace-with-your-access-key
R2_SECRET_ACCESS_KEY=replace-with-your-secret-key
REDIS_URL=redis://localhost:6379
