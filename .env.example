NODE_ENV=development
PORT=5177
# Browser origins only, comma-separated, no trailing slash or /api path.
CORS_ALLOWED_ORIGINS=https://tools.lcgmedia.uk,https://lcgmedia.uk,http://localhost:5173,http://127.0.0.1:5173

# Company login and all AI tools require MongoDB + encryption key + Redis.
AGENT_ENABLED=true
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=lcgmedia
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key in a secret manager; losing/changing it makes existing agent images unreadable.
# AGENT_ASSET_ENCRYPTION_KEY=64-hex-characters
# QUEUE_WORKER_ENABLED controls both Agent and tool consumers.
# Shared concurrency across workers using the same database; keep identical on all workers.
AGENT_CONCURRENCY=3
AGENT_SESSION_HOURS=24
# Shared BullMQ queue. All API/worker replicas must use the same prefix and limits.
QUEUE_ENABLED=true
QUEUE_WORKER_ENABLED=true
QUEUE_PREFIX=lcgmedia-tools
QUEUE_CONCURRENCY=3
QUEUE_USER_CONCURRENCY=2
QUEUE_MAX_PENDING=1000
QUEUE_MAX_PENDING_PER_USER=100
# Google Identity Services: Web application Client ID; no client secret needed.
# Client ID and at least one domain in Company administration are required.
# Allowed email domains are managed in Company administration, stored in MongoDB.
GOOGLE_CLIENT_ID=

# Private diagnostic journal and images; production mounts /app/logs as a volume.
AUDIT_LOG_DIR=./logs
# Optional read-only worker journal directory for administration diagnostics.
AUDIT_WORKER_LOG_DIR=
AUDIT_LOG_RETENTION_DAYS=7
# Image archive cap per UTC day (deduplicated); 0 keeps metadata/hashes only.
AUDIT_IMAGE_MAX_BYTES_PER_DAY=536870912

# ShopAIKey is the default image/vision provider; text uses VyceAI -> ShopAIKey.
AI_PROVIDER=shopaikey
AI_AUTO_TEXT_ROUTING=true
# Text only: discover GPT, then Claude; probe health before each real request.
# VYCEAI_API_KEY=replace-with-your-vyceai-key
VYCEAI_BASE_URL=https://vyceai.com/v1
VYCEAI_TIMEOUT_MS=60000
VYCEAI_HEALTH_TIMEOUT_MS=10000
# AI_TEXT_PROVIDER=gemini
# AI_VISION_PROVIDER=gemini
# AI_IMAGE_PROVIDER=gemini

# GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL_TEXT=gemini-2.5-flash-lite
GEMINI_MODEL_MULTIMODAL=gemini-2.5-flash
# Set an available image model from your Gemini account before starting.
GEMINI_MODEL_IMAGE=replace-with-an-available-image-model

# ShopAIKey supports text, vision, Gemini images, GPT Image and Grok Imagine.
# AI_TEXT_PROVIDER=shopaikey
# AI_VISION_PROVIDER=shopaikey
# AI_IMAGE_PROVIDER=shopaikey
SHOPAIKEY_API_KEY=replace-with-your-shopaikey-key
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
SHOPAIKEY_IMAGE_BASE_URL=https://direct.shopaikey.com
SHOPAIKEY_MODEL_TEXT=gemini-2.5-flash
SHOPAIKEY_MODEL_VISION=gemini-2.5-flash
# Required for images; use a Gemini image, gpt-image-* or grok-imagine-image* ID from the catalog.
# SHOPAIKEY_MODEL_IMAGE=replace-with-an-available-image-model
SHOPAIKEY_TIMEOUT_MS=60000
SHOPAIKEY_IMAGE_TIMEOUT_MS=180000
# Exact HTTPS image CDN hosts; never use a wildcard. No auth headers are forwarded.
SHOPAIKEY_IMAGE_DOWNLOAD_HOSTS=image.chr1.com,direct.shopaikey.com,api.shopaikey.com

R2_ACCOUNT_ID=replace-with-your-account-id
R2_PRIVATE_URL=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=replace-with-your-bucket
# Separate this application's object keys when sharing the bucket with EziHubb.
# Prefix has no leading/trailing slash; public URL is the bucket's CDN root.
R2_KEY_PREFIX=gemini-tools
R2_PUBLIC_URL=https://replace-with-your-public-domain.example
R2_ACCESS_KEY_ID=replace-with-your-access-key
R2_SECRET_ACCESS_KEY=replace-with-your-secret-key
REDIS_URL=redis://localhost:6379

# Backup CLI only; generate a separate 32-byte key, store outside Git and retain it off-server.
# Never reuse AGENT_ASSET_ENCRYPTION_KEY. Leave blank until backups are provisioned.
AGENT_BACKUP_KEY=
AGENT_BACKUP_DIR=backups
